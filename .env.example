# Copy to .env and fill in before going live. Everything here is read at
# request time by the Node server, so no secret ends up in the built assets.

# --- company -----------------------------------------------------------------
COMPUD_LEGAL_NAME="Compud S.r.l."
COMPUD_VAT_NUMBER=""
COMPUD_REA=""
COMPUD_EMAIL=""
COMPUD_PHONE=""
COMPUD_STREET=""
COMPUD_CITY=""
COMPUD_ZIP=""
COMPUD_COUNTRY="IT"

# --- bank account money is transferred to ------------------------------------
# The beneficiary name must match what the bank holds, or transfers bounce.
COMPUD_BANK_HOLDER="Compud S.r.l."
COMPUD_BANK_NAME=""
COMPUD_IBAN=""
COMPUD_BIC=""

# --- commerce ----------------------------------------------------------------
COMPUD_VAT_RATE="22"
# Hours an unpaid order keeps its stock reservation.
COMPUD_HOLD_HOURS="72"
COMPUD_SHIPPING_CENTS="0"

# --- operations --------------------------------------------------------------
# Where orders are persisted (see README: swap for a database in production).
COMPUD_DATA_DIR="./data"
# Shared secret for POST /api/orders/<ref>/confirm. Unset = endpoint disabled.
COMPUD_ADMIN_TOKEN=""

# Absolute site URL, used for canonical and hreflang tags.
SITE_URL="https://www.compud.it"
