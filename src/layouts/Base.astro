---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Lang } from '../i18n/ui';
import { href, useTranslations, type RouteName } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  route: RouteName;
  param?: string;
  active?: 'miniPc' | 'servers' | null;
  /** Checkout and order pages drop the ticker, nav and cart handle. */
  compact?: boolean;
  noindex?: boolean;
}

const { lang, title, description, route, param, active = null, compact = false, noindex = false } =
  Astro.props;
const t = useTranslations(lang);
const canonical = new URL(href(lang, route, param), Astro.site);
const alternates: { lang: Lang; url: URL }[] = [
  { lang: 'it', url: new URL(href('it', route, param), Astro.site) },
  { lang: 'en', url: new URL(href('en', route, param), Astro.site) },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.url.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].url.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="theme-color" content="#0d0f11" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} route={route} param={param} active={active} compact={compact} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
