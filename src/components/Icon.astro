---
/** Stroke icons on a 20/24 grid, drawn inline so they inherit colour. */
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}

const paths = {
  search: '<circle cx="9" cy="9" r="6"/><path d="M13.5 13.5 18 18" stroke-linecap="round"/>',
  user: '<circle cx="10" cy="6.5" r="3.5"/><path d="M3.5 17c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5" stroke-linecap="round"/>',
  cart: '<path d="M2 3h2.6l2 10.5h9.1L17.5 6H5.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8" cy="17" r="1.3" fill="currentColor" stroke="none"/><circle cx="15" cy="17" r="1.3" fill="currentColor" stroke="none"/>',
  menu: '<path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"/>',
  close: '<path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/>',
  shield: '<path d="M10 2l6.5 2.4v5.1c0 3.9-2.6 7.2-6.5 8.5-3.9-1.3-6.5-4.6-6.5-8.5V4.4L10 2z" stroke-linejoin="round"/><path d="M7.2 9.9l2 2 3.6-3.8" stroke-linecap="round" stroke-linejoin="round"/>',
  clock: '<circle cx="10" cy="10" r="7.5"/><path d="M10 5.6V10l3 1.8" stroke-linecap="round"/>',
  rack: '<path d="M3 7.5l7-4 7 4M4.5 8.5v6M8.2 8.5v6M11.8 8.5v6M15.5 8.5v6M2.5 16.5h15" stroke-linecap="round"/>',
  arrow: '<path d="M3 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>',
  list: '<rect x="3" y="3" width="14" height="14" rx="2"/><path d="M6.5 7.5h7M6.5 10.5h7M6.5 13.5h3.5" stroke-linecap="round"/>',
  sliders: '<path d="M3 6h14M3 12h9" stroke-linecap="round"/><circle cx="15" cy="12" r="2.2"/>',
  copy: '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>',
  lock: '<rect x="4" y="9" width="12" height="8" rx="2"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/>',
  transfer: '<path d="M3 7.5h11M11 4l3.5 3.5L11 11" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 13H6M9 16.5 5.5 13 9 9.5" stroke-linecap="round" stroke-linejoin="round"/>',
  check: '<circle cx="10" cy="10" r="7.5"/><path d="M6.6 10.2l2.4 2.4 4.4-4.8" stroke-linecap="round" stroke-linejoin="round"/>',
  alert: '<circle cx="10" cy="10" r="7.5"/><path d="M10 6.2v4.4M10 13.4v.6" stroke-linecap="round"/>',
  card: '<rect x="3" y="5" width="14" height="10" rx="2"/><path d="M3 8.5h14"/>',
  qr: '<rect x="3" y="3" width="6" height="6" rx="1"/><rect x="11" y="3" width="6" height="6" rx="1"/><rect x="3" y="11" width="6" height="6" rx="1"/><path d="M11 11h2.5v2.5H11zM14.5 14.5H17V17h-2.5z"/>',
  trash: '<path d="M4 6h12M8 6V4.5A1.5 1.5 0 0 1 9.5 3h1A1.5 1.5 0 0 1 12 4.5V6M6 6l.8 9.2A1.5 1.5 0 0 0 8.3 16.5h3.4a1.5 1.5 0 0 0 1.5-1.3L14 6" stroke-linecap="round" stroke-linejoin="round"/>',
} as const;

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
