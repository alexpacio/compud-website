  cpu: '<rect x="5.5" y="5.5" width="9" height="9" rx="1.5"/><path d="M8 2.5v3M12 2.5v3M8 14.5v3M12 14.5v3M2.5 8h3M2.5 12h3M14.5 8h3M14.5 12h3" stroke-linecap="round"/>',
  layers: '<path d="M10 2.8 17 6.4l-7 3.6-7-3.6 7-3.6z" stroke-linejoin="round"/><path d="m3 10.4 7 3.6 7-3.6M3 14.2l7 3.6 7-3.6" stroke-linecap="round" stroke-linejoin="round"/>',
  toolbox: '<rect x="2.5" y="6.5" width="15" height="10" rx="1.5"/><path d="M7 6.5V5a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 13 5v1.5M2.5 10.5h15M8.5 9.3h3v2.4h-3z" stroke-linejoin="round"/>',
