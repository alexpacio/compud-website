  building: '<path d="M3.5 17.5v-13a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v13" stroke-linejoin="round"/><path d="M11.5 8.5h4a1 1 0 0 1 1 1v8" stroke-linejoin="round"/><path d="M2 17.5h16M6 6.5h3M6 9.5h3M6 12.5h3M13.5 11.5h1.5M13.5 14.5h1.5" stroke-linecap="round"/>',
  pin: '<path d="M10 17.5s5.5-5 5.5-9a5.5 5.5 0 1 0-11 0c0 4 5.5 9 5.5 9z" stroke-linejoin="round"/><circle cx="10" cy="8.3" r="2.1"/>',
  trash: '<path d="M4 6h12M8 6V4.5A1.5 1.5 0 0 1 9.5 3h1A1.5 1.5 0 0 1 12 4.5V6M6 6l.8 9.2A1.5 1.5 0 0 0 8.3 16.5h3.4a1.5 1.5 0 0 0 1.5-1.3L14 6" stroke-linecap="round" stroke-linejoin="round"/>',
} as const;

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
