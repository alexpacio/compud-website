---
import HardwareGlyph from './HardwareGlyph.astro';
import { pick, type Product } from '../data/catalogue';
import type { Lang } from '../i18n/ui';
import { href, useTranslations } from '../i18n/utils';
import { formatEur } from '../lib/money';

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product } = Astro.props;
const t = useTranslations(lang);
const url =
  product.section === 'nas'
    ? href(lang, 'nasProduct', product.slug)
    : product.section === 'laptop'
      ? href(lang, 'laptopProduct', product.slug)
      : product.section === 'gpu'
        ? href(lang, 'gpuProduct', product.slug)
        : product.section === 'server'
          ? href(lang, 'serverProduct', product.slug)
          : href(lang, 'product', product.slug);

const badge =
  product.stock === 0
    ? { tone: 'chip', label: t('badge.order') }
    : { tone: 'chip chip--ok', label: t('badge.stock') };
---

<article class="pcard">
  <a class="pcard__media" href={url} tabindex="-1" aria-hidden="true">
    {
      product.images?.[0] ? (
        <img class="pcard__img" src={product.images[0]} alt={product.name} loading="lazy" width="440" height="440" />
      ) : (
        <HardwareGlyph glyph={product.glyph} width={220} label={product.name} />
      )
    }
    <span class:list={['pcard__badge', badge.tone]}>
      <span class="chip__dot"></span>
      {badge.label}
    </span>
  </a>

  <div class="pcard__body">
    <div class="pcard__head">
      <p class="kicker">{pick(product.category, lang)}</p>
      <h3 class="pcard__name"><a href={url}>{product.name}</a></h3>
    </div>

    <dl class="pcard__specs">
      {
        product.summary.map((row) => (
          <div class="pcard__spec">
            <dt>{t(row.label)}</dt>
            <dd>{pick(row.value, lang)}</dd>
          </div>
        ))
      }
    </dl>

    <div class="pcard__foot">
      <div class="pcard__price">
        <span class="pcard__priceLabel">{t('price.excl')}</span>
        <span class="pcard__priceValue">{formatEur(product.basePriceCents, lang)}</span>
      </div>
      <a class="btn btn--primary pcard__cta" href={url}>{product.section === 'gpu' ? (lang === 'it' ? 'Dettagli' : 'Details') : (lang === 'it' ? 'Configura' : 'Configure')}</a>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--r-card);
    overflow: hidden;
    transition: border-color .25s, box-shadow .25s, transform .25s;
  }

  .pcard:hover, .pcard:focus-within {
    border-color: #628773;
    box-shadow: 0 18px 48px #00000030;
  }

  .pcard__media {
    position: relative;
    min-width: 0;
    padding-inline: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 210px;
    background: radial-gradient(ellipse at 50% 35%, #34483c80, transparent 70%), linear-gradient(145deg, #1b2420, #101613);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
  }

  /* floor glow under the cut-out product */
  .pcard__media::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 7%;
    z-index: 0;
    width: 68%;
    height: 32px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(62, 210, 138, 0.3),
      transparent 70%
    );
    filter: blur(10px);
    pointer-events: none;
  }

  .pcard__img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    padding: 12px;
    transition: transform .6s cubic-bezier(.2,.7,.3,1);
    filter:
      drop-shadow(0 18px 16px rgba(0, 0, 0, 0.5))
      drop-shadow(0 4px 8px rgba(0, 0, 0, 0.35));
  }

  .pcard:hover .pcard__img { transform: translateY(-5px) scale(1.035); }

  .pcard__badge {
    position: absolute;
    top: 14px;
    left: 16px;
    z-index: 2;
  }

  .pcard__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1 1 auto;
  }

  .pcard__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pcard__name {
    font-size: 20px;
    font-weight: 500;
  }

  .pcard__specs {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .pcard__spec {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .pcard__spec dt {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11px;
  }

  .pcard__spec dd {
    margin: 0;
    color: var(--text-2);
    text-align: right;
  }

  .pcard__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--line-faint);
  }

  .pcard__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pcard__priceLabel {
    font-size: 11px;
    color: var(--muted-2);
  }

  .pcard__priceValue {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
  }

  .pcard__cta {
    padding: 11px 16px;
    font-size: 14px;
  }
</style>
