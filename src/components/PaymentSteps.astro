---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { n: 1, title: t('pay.step1.title'), body: t('pay.step1.body') },
  { n: 2, title: t('pay.step2.title'), body: t('pay.step2.body') },
  { n: 3, title: t('pay.step3.title'), body: t('pay.step3.body') },
];
---

<section class="band band--tint pay">
  <div class="wrap pay__inner">
    <div class="pay__head">
      <div class="pay__headText">
        <p class="kicker kicker--accent">{t('pay.kicker')}</p>
        <h2 class="h2 pay__title">{t('pay.title')}</h2>
      </div>
      <p class="pay__note">{t('pay.note')}</p>
    </div>

    <ol class="pay__steps">
      {
        steps.map((step) => (
          <li class="panel pay__step">
            <div class="pay__stepHead">
              <span class="pay__stepNumber">{step.n}</span>
              <h3 class="pay__stepTitle">{step.title}</h3>
            </div>
            <p class="pay__stepBody">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pay__inner {
    padding-block: 68px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pay__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .pay__headText {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pay__title {
    max-width: 620px;
  }

  .pay__note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 360px;
  }

  .pay__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pay__step {
    background: var(--surface-2);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pay__stepHead {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pay__stepNumber {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-ink);
    background: var(--accent);
    width: 22px;
    height: 22px;
    border-radius: var(--r-chip);
    display: grid;
    place-items: center;
    flex: none;
  }

  .pay__stepTitle {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
  }

  .pay__stepBody {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .pay__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .pay__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
