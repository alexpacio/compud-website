---
import type { Glyph } from '../data/catalogue';

/**
 * Vector stand-ins for product photography. Replace these with real photos of
 * the machines as soon as the shoot is done — the markup expects a square-ish
 * asset centred in the frame.
 */
interface Props {
  glyph: Glyph;
  width?: number;
  label?: string;
}
const { glyph, width = 220, label } = Astro.props;
const box = glyph === 'laptop' ? { w: 260, h: 176 } : glyph === 'rack' ? { w: 460, h: 330 } : { w: 220, h: 150 };
---

<svg
  width={box.w}
  height={box.h}
  viewBox={`0 0 ${box.w} ${box.h}`}
  style={`width: 100%; max-width: ${width}px; height: auto;`}
  fill="none"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  {glyph === 'mini' && (
    <g>
      <rect x="30" y="24" width="160" height="102" rx="8" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      <rect x="44" y="38" width="132" height="60" rx="4" fill="#14181b" stroke="#2f353b" />
      <path d="M56 50h108M56 60h108M56 70h108M56 80h108" stroke="#242a30" stroke-width="2" stroke-linecap="round" />
      <circle cx="54" cy="112" r="4" fill="#3ed28a" />
      <rect x="70" y="108" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="96" y="108" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="126" y="107" width="10" height="10" rx="2" fill="#2a3036" />
      <rect x="52" y="126" width="116" height="5" rx="2" fill="#101315" />
    </g>
  )}
  {glyph === 'miniCompact' && (
    <g>
      <rect x="42" y="30" width="136" height="92" rx="8" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      <rect x="56" y="44" width="108" height="52" rx="4" fill="#14181b" stroke="#2f353b" />
      <path d="M68 56h84M68 66h84M68 76h84" stroke="#242a30" stroke-width="2" stroke-linecap="round" />
      <circle cx="66" cy="108" r="4" fill="#3ed28a" />
      <rect x="82" y="104" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="108" y="104" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="62" y="122" width="96" height="5" rx="2" fill="#101315" />
    </g>
  )}
  {glyph === 'miniNetwork' && (
    <g>
      <rect x="38" y="28" width="144" height="96" rx="6" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      <rect x="50" y="40" width="120" height="44" rx="3" fill="#14181b" stroke="#2f353b" />
      <rect x="60" y="52" width="26" height="20" rx="2" fill="#0f1315" stroke="#3ed28a" stroke-width="1.2" />
      <rect x="94" y="52" width="26" height="20" rx="2" fill="#0f1315" stroke="#3ed28a" stroke-width="1.2" />
      <rect x="128" y="52" width="30" height="20" rx="2" fill="#0f1315" stroke="#2f353b" />
      <circle cx="58" cy="104" r="4" fill="#3ed28a" />
      <rect x="74" y="100" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="100" y="100" width="18" height="8" rx="4" fill="#2a3036" />
      <rect x="126" y="99" width="34" height="10" rx="2" fill="#2a3036" />
      <rect x="58" y="124" width="104" height="5" rx="2" fill="#101315" />
    </g>
  )}
  {glyph === 'nas' && (
    <g>
      <rect x="62" y="18" width="96" height="118" rx="8" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      {[30, 48, 66, 84, 102].map((y) => (
        <g>
          <rect x="72" y={y} width="76" height="12" rx="2" fill="#12161a" stroke="#3a4147" />
          <circle cx={140} cy={y + 6} r="2" fill="#3ed28a" />
        </g>
      ))}
      <rect x="72" y="120" width="40" height="6" rx="3" fill="#2a3036" />
      <circle cx="140" cy="123" r="3" fill="#2a3036" />
    </g>
  )}
  {glyph === 'gpu' && (
    <g>
      <rect x="18" y="26" width="9" height="98" rx="1.5" fill="#333a40" stroke="#2a2f35" />
      {[36, 56, 76].map((y) => (
        <rect x="19" y={y} width="7" height="14" rx="1.5" fill="#12161a" stroke="#3a4147" />
      ))}
      <rect x="27" y="30" width="168" height="84" rx="5" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      <rect x="33" y="36" width="156" height="66" rx="4" fill="#171b1f" stroke="#2f353b" />
      {[72, 142].map((cx) => (
        <g>
          <circle cx={cx} cy="69" r="22" fill="#12161a" stroke="#2f353b" />
          {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
            <path
              d={`M${cx} ${69 - 7} q9 -5 13 -11`}
              stroke="#242a30"
              stroke-width="2.5"
              stroke-linecap="round"
              transform={`rotate(${a} ${cx} 69)`}
            />
          ))}
          <circle cx={cx} cy="69" r="6" fill="#1f2429" stroke="#3a4147" />
        </g>
      ))}
      <rect x="160" y="21" width="30" height="10" rx="2" fill="#2a3036" stroke="#3a4147" />
      <circle cx="186" cy="41" r="3" fill="#3ed28a" />
      <rect x="27" y="108" width="168" height="6" rx="2" fill="#101315" />
      <rect x="46" y="116" width="42" height="10" rx="1" fill="#b8912f" />
      <rect x="94" y="116" width="76" height="10" rx="1" fill="#b8912f" />
    </g>
  )}
  {glyph === 'rack' && (
    <g>
      <rect x="26" y="18" width="408" height="294" rx="6" fill="#101315" stroke="#2a2f35" stroke-width="1.5" />
      <rect x="34" y="26" width="392" height="10" rx="2" fill="#181c20" />
      <rect x="34" y="44" width="392" height="44" rx="3" fill="#1f2429" stroke="#3a4147" stroke-width="1.2" />
      <rect x="44" y="54" width="10" height="24" rx="1.5" fill="#333a40" />
      <rect x="406" y="54" width="10" height="24" rx="1.5" fill="#333a40" />
      {[64, 100, 136, 172, 208, 244, 280, 316].map((x) => (
        <rect x={x} y="53" width="32" height="26" rx="2" fill="#12161a" stroke="#3a4147" />
      ))}
      <circle cx="368" cy="60" r="3" fill="#3ed28a" />
      <circle cx="368" cy="72" r="3" fill="#2a3036" />
      <rect x="34" y="96" width="392" height="44" rx="3" fill="#1f2429" stroke="#3a4147" stroke-width="1.2" />
      <rect x="44" y="106" width="10" height="24" rx="1.5" fill="#333a40" />
      <rect x="406" y="106" width="10" height="24" rx="1.5" fill="#333a40" />
      {[64, 100, 136, 172, 208, 244, 280, 316].map((x) => (
        <rect x={x} y="105" width="32" height="26" rx="2" fill="#12161a" stroke="#3a4147" />
      ))}
      <circle cx="368" cy="112" r="3" fill="#3ed28a" />
      <circle cx="368" cy="124" r="3" fill="#3ed28a" />
      <rect x="34" y="148" width="392" height="28" rx="3" fill="#181c20" stroke="#2a2f35" stroke-width="1.2" />
      <path d="M56 162h150M226 162h70" stroke="#2a3036" stroke-width="2" stroke-linecap="round" />
      <circle cx="368" cy="162" r="3" fill="#333a40" />
      <rect x="34" y="184" width="392" height="28" rx="3" fill="#181c20" stroke="#2a2f35" stroke-width="1.2" />
      <path d="M56 198h150M226 198h70" stroke="#2a3036" stroke-width="2" stroke-linecap="round" />
      <circle cx="368" cy="198" r="3" fill="#333a40" />
      <rect x="34" y="220" width="392" height="36" rx="3" fill="#1f2429" stroke="#3a4147" stroke-width="1.2" />
      {[60, 128, 196].map((x) => (
        <rect x={x} y="230" width="60" height="16" rx="2" fill="#12161a" stroke="#3a4147" />
      ))}
      <circle cx="368" cy="238" r="3" fill="#e0a33c" />
      <rect x="34" y="264" width="392" height="40" rx="3" fill="#16191c" stroke="#2a2f35" stroke-width="1.2" />
      <path d="M64 284h80M164 284h40" stroke="#242a30" stroke-width="2" stroke-linecap="round" />
    </g>
  )}
  {glyph === 'laptop' && (
    <g>
      <path d="M22 142 L44 126 L216 126 L238 142 Z" fill="#161a1e" stroke="#3a4147" stroke-width="1.5" />
      <rect x="38" y="144" width="184" height="6" rx="3" fill="#101315" />
      <rect x="34" y="14" width="192" height="112" rx="6" fill="#1f2429" stroke="#3a4147" stroke-width="1.5" />
      <rect x="44" y="24" width="172" height="92" rx="3" fill="#0f3a5f" stroke="#2f353b" />

      {/* KDE Plasma desktop: Breeze-blue wallpaper, Tux, bottom panel. */}
      <g clip-path="inset(0)">
        <rect x="44" y="24" width="172" height="80" fill="#0f3a5f" />
        <path d="M44 82 L216 46 L216 104 L44 104 Z" fill="#1d6fa5" opacity="0.9" />
        <path d="M44 94 L216 62 L216 104 L44 104 Z" fill="#2a8dd0" opacity="0.5" />
        <path d="M44 40 L216 24 L216 34 L44 56 Z" fill="#3daee9" opacity="0.28" />
      </g>

      <g transform="translate(130 62) scale(0.62)">
        <ellipse cx="-11" cy="30" rx="10" ry="5" fill="#f2a71b" />
        <ellipse cx="11" cy="30" rx="10" ry="5" fill="#f2a71b" />
        <ellipse cx="0" cy="6" rx="22" ry="26" fill="#17191c" />
        <circle cx="0" cy="-19" r="16" fill="#17191c" />
        <ellipse cx="-21" cy="8" rx="6" ry="14" fill="#17191c" transform="rotate(12 -21 8)" />
        <ellipse cx="21" cy="8" rx="6" ry="14" fill="#17191c" transform="rotate(-12 21 8)" />
        <ellipse cx="0" cy="11" rx="14" ry="19" fill="#f2f4f5" />
        <ellipse cx="-6" cy="-21" rx="6" ry="7" fill="#f2f4f5" />
        <ellipse cx="6" cy="-21" rx="6" ry="7" fill="#f2f4f5" />
        <circle cx="-5" cy="-20" r="2.6" fill="#17191c" />
        <circle cx="5" cy="-20" r="2.6" fill="#17191c" />
        <ellipse cx="0" cy="-11" rx="7" ry="5" fill="#f2a71b" />
        <path d="M-7 -11h14" stroke="#c9861a" stroke-width="1.2" />
      </g>

      <rect x="44" y="104" width="172" height="12" fill="#2a2e32" opacity="0.94" />
      <circle cx="53" cy="110" r="4" fill="#3daee9" />
      {[64, 82, 100].map((x) => (
        <rect x={x} y="106" width="16" height="8" rx="2" fill="#3a4147" />
      ))}
      {[176, 184, 192].map((x) => (
        <circle cx={x} cy="110" r="1.8" fill="#5c666e" />
      ))}
      <rect x="200" y="107" width="12" height="6" rx="1.5" fill="#5c666e" />

      <circle cx="130" cy="19" r="1.8" fill="#3a4147" />
      <rect x="44" y="118" width="172" height="4" rx="2" fill="#2a3036" />
      <circle cx="140" cy="133" r="3" fill="#3ed28a" />
      <rect x="152" y="129" width="22" height="8" rx="4" fill="#2a3036" />
      <rect x="180" y="129" width="14" height="8" rx="4" fill="#2a3036" />
    </g>
  )}
</svg>
