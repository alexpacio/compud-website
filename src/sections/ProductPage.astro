---
import HardwareGlyph from '../components/HardwareGlyph.astro';
import Icon from '../components/Icon.astro';
import Video from '../components/Video.astro';
import Configurator, { type ConfigGroup } from '../islands/Configurator.tsx';
import { defaultChoice, pick, type Product } from '../data/catalogue';
import type { Lang } from '../i18n/ui';
import { href, useTranslations } from '../i18n/utils';
import { commerce, company } from '../lib/config';

interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product } = Astro.props;
const t = useTranslations(lang);

const groups: ConfigGroup[] = [
  { id: 'ram', label: t('pdp.optRam'), options: product.options.ram },
  {
    id: 'ssd',
    // With a separate bay group the M.2 pair needs a name of its own.
    label: product.options.bay ? t('pdp.optNvme') : t('pdp.optSsd'),
    options: product.options.ssd,
  },
  ...(product.options.bay ? [{ id: 'bay' as const, label: t('pdp.optBay'), options: product.options.bay }] : []),
  ...(product.options.gpu ? [{ id: 'gpu' as const, label: t('pdp.optGpu'), options: product.options.gpu }] : []),
  ...(product.options.psu ? [{ id: 'psu' as const, label: t('pdp.optPsu'), options: product.options.psu }] : []),
  { id: 'os', label: t('pdp.optOs'), options: product.options.os },
].map((group) => ({
  id: group.id as ConfigGroup['id'],
  label: group.label,
  // A used GPU has no RAM, disk or OS: its option groups are schema filler.
  hidden: (product.section ?? 'miniPc') === 'gpu',
  options: group.options.map((option) => ({
    id: option.id,
    label: pick(option.label, lang),
    addCents: option.addCents,
    spec: pick(option.spec ?? option.label, lang),
  })),
}));

const stockChip =
  product.stock === 0
    ? { tone: 'chip', label: t('badge.order') }
    : { tone: 'chip chip--ok', label: t('badge.stock') };

const section = product.section ?? 'miniPc';
const sectionRoute = section === 'nas' ? 'nas' : section === 'laptop' ? 'laptop' : section === 'gpu' ? 'gpu' : section === 'server' ? 'servers' : 'miniPc';
const sectionLabel =
  section === 'nas'
    ? t('nav.nas')
    : section === 'laptop'
      ? t('nav.laptop')
      : section === 'gpu'
        ? t('nav.gpu')
        : section === 'server'
          ? t('nav.servers')
          : t('nav.miniPc');

/** Attribution brand, taken from the host of the source page. */
const sourceBrand = product.sourceUrl
  ? new URL(product.sourceUrl).hostname.replace(/^www\./, '').split('.')[0].toUpperCase()
  : '';

const isServer = section === 'server';
const hasSingleProduct = isServer || section === 'miniPc' || section === 'nas';
const hasPhotos = !!product.images?.length;
const quoteUrl = `mailto:${company.email}?subject=${encodeURIComponent(`${t('rack.quote')} — ${product.name}`)}`;
const process = [
  { n: '01', title: t('rack.p1.title'), body: t('rack.p1.body') },
  { n: '02', title: t('rack.p2.title'), body: t('rack.p2.body') },
  { n: '03', title: t('rack.p3.title'), body: t('rack.p3.body') },
  { n: '04', title: t('rack.p4.title'), body: t('rack.p4.body') },
];

const prep = [
  { icon: 'clock', title: t('pdp.prep1.title'), body: t('pdp.prep1.body') },
  { icon: 'list', title: t('pdp.prep2.title'), body: product.linuxNote ? pick(product.linuxNote, lang) : t('pdp.prep2.body') },
  { icon: 'shield', title: t('pdp.prep3.title'), body: t('pdp.prep3.body') },
] as const;

---

<nav class="band crumbs" aria-label={t('pdp.crumbHome')}>
  <div class="wrap">
    <p class="mono crumbs__text">
      <a href={href(lang, 'home')}>{t('pdp.crumbHome').toUpperCase()}</a>
      <span aria-hidden="true"> / </span>
      {
        hasSingleProduct ? (
          <span>{sectionLabel.toUpperCase()}</span>
        ) : (
          <a href={href(lang, sectionRoute)}>{sectionLabel.toUpperCase()}</a>
        )
      }
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{product.name.toUpperCase()}</span>
    </p>
  </div>
</nav>

<section class="band pdp">
  <div class="wrap pdp__inner">
    <div class="pdp__media">
      {
        hasPhotos ? (
          <>
            <div class="pdp__frame">
              <p class="mono pdp__figNote">
                {product.name} — {t('pdp.photoCount', { n: product.images!.length })}
              </p>
              <img
                id="pdpMain"
                class="pdp__img"
                src={product.images![0]}
                alt={product.name}
                fetchpriority="high"
              />
            </div>
            <div class="pdp__thumbs" style={`--pdp-photo-count: ${Math.min(product.images!.length, 5)}`} role="group" aria-label={product.name}>
              {product.images!.map((src, i) => (
                <button
                  type="button"
                  class:list={['pdp__thumbBtn', i === 0 && 'is-active']}
                  data-src={src}
                  aria-pressed={i === 0 ? "true" : "false"}
                  aria-label={`${product.name} — ${t('pdp.photoNth', { n: i + 1 })}`}
                >
                  <img src={src} alt="" loading="lazy" width="220" height="220" />
                </button>
              ))}
            </div>
          </>
        ) : product.video ? null : (
          <>
            <div class="pdp__frame">
              <p class="mono pdp__figNote">{t('home.figNote')}</p>
              <HardwareGlyph glyph={product.glyph} width={480} label={product.name} />
            </div>
          </>
        )
      }
      {
        product.video ? (
          <Video
            src={product.video}
            label={`${product.name} — ${t('pdp.videoNote')}`}
            note={t('pdp.videoNote')}
          />
        ) : null
      }
    </div>

    <div class="pdp__buy">
      <div class="pdp__head">
        <div class="pdp__meta">
          <span class:list={[stockChip.tone]}><span class="chip__dot"></span>{stockChip.label}</span>
          <span class="mono pdp__sku">SKU {product.sku}</span>
        </div>
        <h1 class="pdp__title">{product.name}</h1>
        <p class="pdp__tagline">{pick(product.tagline, lang)}</p>
      </div>

      {product.linuxNote && <p class="pdp__linuxNote">{pick(product.linuxNote, lang)}</p>}

      <Configurator
        client:load
        lang={lang}
        slug={product.slug}
        basePriceCents={product.basePriceCents}
        vatRate={commerce.vatRate}
        groups={groups}
        defaults={defaultChoice(product)}
        checkoutUrl={href(lang, 'checkout')}
        strings={{
          included: t('pdp.included'),
          excl: t('price.excl'),
          incl: t('price.incl', { rate: commerce.vatRate }),
          payLine: t('pdp.payLine'),
          buyNow: t('pdp.buyNow'),
          addCart: t('cart.add'),
          added: t('cart.added'),
          shipLine: product.fulfillmentNote ? pick(product.fulfillmentNote, lang) : t('pdp.shipLine'),
        }}
      />
    </div>
  </div>
</section>

{
  (product.highlights?.length || product.details) && (
    <section class="band pdpDetail">
      <div class="wrap pdpDetail__inner">
        {product.highlights?.length ? (
          <div class="pdpDetail__col">
            <h2 class="h2">{t('pdp.highlightsTitle')}</h2>
            <ul class="hl">
              {product.highlights.map((h) => (
                <li class="hl__item">{pick(h, lang)}</li>
              ))}
            </ul>
          </div>
        ) : null}
        {product.details ? (
          <div class="pdpDetail__col">
            <h2 class="h2">{t('pdp.detailsTitle')}</h2>
            <div class="pdpDetail__copy">
              {pick(product.details, lang).split(/\n\n+/).map((paragraph) => (
                <p class="pdpDetail__text">{paragraph}</p>
              ))}
            </div>
            {product.sourceUrl ? (
              <p class="mono pdpDetail__src">
                {t('pdp.sourceNote', { brand: sourceBrand })}{' '}
                <a href={product.sourceUrl} target="_blank" rel="noopener nofollow">
                  {sourceBrand} ↗
                </a>
              </p>
            ) : null}
          </div>
        ) : null}
      </div>
    </section>
  )
}

{
  product.features?.length ? (
    <section class="band pdpFeatures" aria-labelledby="pdpFeaturesTitle">
      <div class="wrap pdpFeatures__inner">
        <h2 class="h2" id="pdpFeaturesTitle">{t('pdp.featuresTitle')}</h2>
        <div class="pdpFeatures__grid">
          {product.features.map((feature) => (
            <article class="panel pdpFeatures__card">
              <p class="pdpFeatures__value">{pick(feature.value, lang)}</p>
              <h3 class="pdpFeatures__title">{pick(feature.title, lang)}</h3>
              <p class="pdpFeatures__body">{pick(feature.body, lang)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<section class="band pdp2">
  <div class="wrap pdp2__inner">
    <div class="pdp2__specs">
      <h2 class="h2">{t('pdp.specTitle')}</h2>
      <dl class="spec">
        {
          product.specs.map((row) => (
            <div class="spec__row">
              <dt class="spec__key">{t(row.label)}</dt>
              <dd class="spec__value">{pick(row.value, lang)}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="pdp2__prep">
      <h2 class="h2">{t('pdp.prepTitle')}</h2>
      <ul class="prep">
        {
          prep.map((item) => (
            <li class="panel prep__item">
              <span class="prep__icon"><Icon name={item.icon} size={20} /></span>
              <div class="prep__text">
                <h3 class="prep__title">{item.title}</h3>
                <p class="prep__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

{
  isServer && (
    <section class="band srvProcess">
      <div class="wrap srvProcess__inner">
        <h2 class="h2">{t('rack.processTitle')}</h2>
        <ol class="srvProcess__grid">
          {process.map((step, index) => (
            <li class:list={['srvProcess__step', { 'is-first': index === 0 }]}>
              <span class="mono srvProcess__n">{step.n}</span>
              <h3 class="srvProcess__title">{step.title}</h3>
              <p class="srvProcess__body">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  isServer && (
    <section class="band--tint srvCta">
      <div class="wrap srvCta__inner">
        <div class="srvCta__text">
          <h2 class="h2 srvCta__title">{t('rack.ctaTitle')}</h2>
          <p class="srvCta__sub">{t('rack.ctaSub')}</p>
        </div>
        <div class="srvCta__actions">
          <a class="btn btn--primary" href={quoteUrl}>
            {t('rack.quote')}
          </a>
          {company.phone && (
            <a class="btn btn--ghost" href={`tel:${company.phone}`}>
              {t('rack.call')}
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  const main = document.getElementById('pdpMain');
  const thumbs = Array.from(document.querySelectorAll('.pdp__thumbBtn'));
  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (main && src) main.setAttribute('src', src);
      thumbs.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
    });
  });
</script>

<style>
  .crumbs__text {
    padding-block: 18px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted-2);
  }

  .crumbs__text a {
    color: var(--muted-2);
  }

  .pdp__inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    padding-block: 44px 64px;
  }

  .pdp__media {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .pdp__frame {
    position: relative;
    min-width: 0;
    min-height: 460px;
    background: radial-gradient(ellipse at 50% 35%, #314b3c80, transparent 70%), linear-gradient(145deg, #1a231f, #0c1310);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    display: grid;
    place-items: center;
    padding: 32px;
    overflow: hidden;
    isolation: isolate;
  }

  /* soft top light + floor glow under the cut-out product */
  .pdp__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(120deg, transparent 20%, #c6ffe910 45%, transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 63px, #b8edcf08 63px 64px),
      repeating-linear-gradient(90deg, transparent 0 63px, #b8edcf08 63px 64px);
    animation: studio-light 2s ease-out both;
    pointer-events: none;
  }

  .pdp__frame::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 8%;
    z-index: 0;
    width: 62%;
    height: 56px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(62, 210, 138, 0.38),
      rgba(62, 210, 138, 0.08) 55%,
      transparent 72%
    );
    filter: blur(12px);
    pointer-events: none;
  }

  .pdp__figNote {
    position: absolute;
    top: 18px;
    left: 20px;
    z-index: 2;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pdp__thumbs {
    display: grid;
    grid-template-columns: repeat(var(--pdp-photo-count, 5), minmax(0, 1fr));
    gap: 12px;
  }

  .pdp__thumb {
    height: 88px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
  }

  .pdp__thumb.is-active {
    border-color: var(--accent);
  }

  .pdp__img {
    position: relative;
    z-index: 1;
    width: auto;
    max-width: 100%;
    max-height: 360px;
    height: auto;
    object-fit: contain;
    filter:
      drop-shadow(0 30px 28px rgba(0, 0, 0, 0.55))
      drop-shadow(0 6px 12px rgba(0, 0, 0, 0.4));
  }

  .pdp__thumbBtn {
    height: 88px;
    padding: 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    cursor: pointer;
  }

  .pdp__thumbBtn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @keyframes studio-light { from { opacity: 0; transform: translateX(-25px); } to { opacity: 1; transform: translateX(0); } }

  .pdp__thumbBtn.is-active {
    border-color: var(--accent);
  }

  .pdpDetail__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding-block: 8px 64px;
  }

  .pdpDetail__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hl__item {
    position: relative;
    padding-left: 26px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .hl__item::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .pdpDetail__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pdpDetail__text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  .pdpDetail__src {
    font-size: 11px;
    color: var(--muted-2);
  }

  .pdpDetail__src a {
    color: var(--muted-2);
    text-decoration: underline;
  }

  .pdpFeatures__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 36px 56px;
  }

  .pdpFeatures__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pdpFeatures__card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: linear-gradient(145deg, var(--surface-2), var(--surface));
  }

  .pdpFeatures__value {
    font-family: var(--font-display);
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--accent);
  }

  .pdpFeatures__title {
    font-size: 18px;
    line-height: 1.35;
  }

  .pdpFeatures__body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .pdpFeatures__grid {
      grid-template-columns: 1fr;
    }
  }

  .pdp__buy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .pdp__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pdp__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pdp__sku {
    font-size: 11px;
    color: var(--muted-2);
  }

  .pdp__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 700;
    line-height: 1.08;
  }

  .pdp__linuxNote { padding: 16px 18px; border-left: 2px solid var(--accent); background: var(--accent-bg); color: var(--text-2); font-size: 13px; line-height: 1.65; }

  .pdp__tagline {
    font-size: 15px;
    line-height: 1.6;
    color: #a8b0b7;
  }

  .pdp2__inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    padding-block: 60px 70px;
  }

  .pdp2__specs,
  .pdp2__prep {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .spec {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    overflow: hidden;
  }

  .spec__row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line-faint);
  }

  .spec__row:nth-child(odd) {
    background: var(--surface);
  }

  .spec__row:last-child {
    border-bottom: 0;
  }

  .spec__key {
    font-size: 13px;
    color: var(--muted);
  }

  .spec__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: right;
  }

  .prep {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prep__item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px;
  }

  .prep__icon {
    color: var(--accent);
    display: inline-flex;
    flex: none;
  }

  .prep__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .prep__title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
  }

  .prep__body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .srvProcess__inner {
    padding-block: 62px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .srvProcess__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .srvProcess__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 2px solid var(--line-strong);
    padding-top: 16px;
  }

  .srvProcess__step.is-first {
    border-top-color: var(--accent);
  }

  .srvProcess__n {
    font-size: 11px;
    color: var(--muted-2);
  }

  .srvProcess__step.is-first .srvProcess__n {
    color: var(--accent);
  }

  .srvProcess__title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
  }

  .srvProcess__body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .srvCta__inner {
    padding-block: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .srvCta__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .srvCta__title {
    font-size: clamp(24px, 2.4vw, 28px);
    max-width: 620px;
  }

  .srvCta__sub {
    font-size: 14px;
    color: var(--muted);
  }

  .srvCta__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .srvProcess__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .srvProcess__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 1000px) {
    .pdp__inner,
    .pdpDetail__inner,
    .pdp2__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-block: 32px 48px;
    }
    .pdp__frame {
      min-height: 300px;
    }
  }

  @media (max-width: 560px) {
    .spec__row {
      flex-direction: column;
      gap: 4px;
    }
    .spec__value {
      text-align: left;
    }
  }
</style>
