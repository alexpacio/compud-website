---
import CheckoutForm, { type CatalogueEntry } from '../islands/CheckoutForm.tsx';
import { miniPcHref, pick, products } from '../data/catalogue';
import type { Lang } from '../i18n/ui';
import { href, useTranslations } from '../i18n/utils';
import { commerce } from '../lib/config';
import Stepper from '../components/Stepper.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/** Only what the cart needs to price and label itself, no marketing copy. */
const catalogue: Record<string, CatalogueEntry> = Object.fromEntries(
  products.map((product) => {
    const section = product.section ?? 'miniPc';
    const url =
      section === 'nas'
        ? href(lang, 'nasProduct', product.slug)
        : section === 'laptop'
          ? href(lang, 'laptopProduct', product.slug)
          : section === 'gpu'
            ? href(lang, 'gpuProduct', product.slug)
            : section === 'server'
              ? href(lang, 'serverProduct', product.slug)
              : href(lang, 'product', product.slug);
    const view = (list: { id: string; label: unknown; addCents: number }[]) =>
      Object.fromEntries(list.map((o) => [o.id, { label: pick(o.label as never, lang), addCents: o.addCents }]));
    return [
      product.slug,
      {
        name: product.name,
        url,
        basePriceCents: product.basePriceCents,
        options: {
          ram: view(product.options.ram),
          ssd: view(product.options.ssd),
          os: view(product.options.os),
          ...(product.options.gpu ? { gpu: view(product.options.gpu) } : {}),
          ...(product.options.psu ? { psu: view(product.options.psu) } : {}),
          ...(product.options.bay ? { bay: view(product.options.bay) } : {}),
        },
      },
    ];
  }),
);
---

<Stepper lang={lang} current={1} />

<section class="checkout">
  <div class="wrap checkout__inner">
    <CheckoutForm
      client:load
      lang={lang}
      vatRate={commerce.vatRate}
      shippingCents={commerce.shippingCents}
      catalogue={catalogue}
      browseUrl={miniPcHref(lang)}
      strings={{
        title: t('co.title'),
        intro: t('co.intro'),
        empty: t('co.empty'),
        emptyCta: t('co.emptyCta'),
        summary: t('co.summary'),
        qty: t('co.qty'),
        remove: t('co.remove'),
        subtotal: t('co.subtotal'),
        shipping: t('co.shipping'),
        free: t('co.free'),
        payFee: t('co.payFee'),
        vat: t('co.vat', { rate: commerce.vatRate }),
        total: t('co.total'),
        fName: t('co.f.name'),
        fCompany: t('co.f.company'),
        fVat: t('co.f.vat'),
        fEmail: t('co.f.email'),
        fPhone: t('co.f.phone'),
        fAddress: t('co.f.address'),
        fZip: t('co.f.zip'),
        fCity: t('co.f.city'),
        fProvince: t('co.f.province'),
        fCountry: t('co.f.country'),
        fNotes: t('co.f.notes'),
        required: t('co.required'),
        invalidEmail: t('co.invalidEmail'),
        submit: t('co.submit'),
        submitting: t('co.submitting'),
        error: t('co.error'),
        mailSubject: t('co.mailSubject'),
        mailIntro: t('co.mailIntro'),
        mailItems: t('co.mailItems'),
        mailNet: t('co.mailNet'),
        mailCustomer: t('co.mailCustomer'),
        mailOutro: t('co.mailOutro'),
        sentTitle: t('co.sentTitle'),
        sentBody: t('co.sentBody'),
        sentReopen: t('co.sentReopen'),
        privacy: t('co.privacy'),
      }}
    />
  </div>
</section>

<style>
  .checkout__inner {
    padding-block: 48px 80px;
  }
</style>
