---
import Audience from '../components/Audience.astro';
import ComputeArtwork from '../components/ComputeArtwork.astro';
import Workloads from '../components/Workloads.astro';
import Icon from '../components/Icon.astro';
import OnSite from '../components/OnSite.astro';
import PaymentSteps from '../components/PaymentSteps.astro';
import ProductCard from '../components/ProductCard.astro';
import TurnkeyStack from '../components/TurnkeyStack.astro';
import { miniPcHref, nasHref, products, serversHref } from '../data/catalogue';
import type { Lang } from '../i18n/ui';
import { href, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const trust = [
  { icon: 'terminal', label: t('home.trust1') },
  { icon: 'clock', label: t('home.trust2') },
  { icon: 'toolbox', label: t('home.trust3') },
] as const;

const why = [
  { icon: 'terminal', title: t('why.1.title'), body: t('why.1.body') },
  { icon: 'layers', title: t('why.2.title'), body: t('why.2.body') },
  { icon: 'shield', title: t('why.3.title'), body: t('why.3.body') },
  { icon: 'cpu', title: t('why.4.title'), body: t('why.4.body') },
] as const;

const miniPcItems = products.filter((product) => (product.section ?? 'miniPc') === 'miniPc');
const nasItems = products.filter((product) => (product.section ?? 'miniPc') === 'nas');
const laptopItems = products.filter((product) => (product.section ?? 'miniPc') === 'laptop');
const gpuItems = products.filter((product) => (product.section ?? 'miniPc') === 'gpu');
const serverItems = products.filter((product) => (product.section ?? 'miniPc') === 'server');
---

<section class="band hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="chip chip--ok"><span class="chip__dot"></span>{t('home.eyebrow')}</p>
      <h1 class="h1 hero__title">{t('home.h1')} <span>{t('home.h1Accent')}</span></h1>
      <p class="lead hero__sub">{t('home.sub')}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#workloads">{t('home.ctaPrimary')}<Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href="#onsite">{t('home.ctaOnsite')}</a>
      </div>

      <ul class="hero__trust">
        {
          trust.map((item) => (
            <li class="hero__trustItem">
              <span class="hero__trustIcon"><Icon name={item.icon} size={18} /></span>
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__figure">
      <ComputeArtwork lang={lang} />
    </div>
  </div>
</section>

<Workloads lang={lang} />

<Audience lang={lang} />

<TurnkeyStack lang={lang} />

<section class="band products">
  <div class="wrap products__inner">
    <header class="products__head">
      <div class="products__titleWrap">
        <h2 class="h2">{t('mini.title')}</h2>
        <p class="lead products__sub">{t('mini.lead')}</p>
      </div>
      <a class="products__all" href={miniPcHref(lang)}>
        {t('mini.all')}
        <Icon name="arrow" size={16} />
      </a>
    </header>

    <div class="products__grid">
      {miniPcItems.map((product) => <ProductCard lang={lang} product={product} />)}
    </div>
  </div>
</section>

{
  nasItems.length > 0 && (
    <section class="band products">
      <div class="wrap products__inner">
        <header class="products__head">
          <div class="products__titleWrap">
            <h2 class="h2">{t('nas.title')}</h2>
            <p class="lead products__sub">{t('nas.lead')}</p>
          </div>
          <a class="products__all" href={nasHref(lang)}>
            {t('nas.all')}
            <Icon name="arrow" size={16} />
          </a>
        </header>

        <div class="products__grid">
          {nasItems.map((product) => <ProductCard lang={lang} product={product} />)}
        </div>
      </div>
    </section>
  )
}

{
  laptopItems.length > 0 && (
    <section class="band products">
      <div class="wrap products__inner">
        <header class="products__head">
          <div class="products__titleWrap">
            <h2 class="h2">{t('laptop.title')}</h2>
            <p class="lead products__sub">{t('laptop.lead')}</p>
          </div>
          <a class="products__all" href={href(lang, 'laptop')}>
            {t('laptop.all')}
            <Icon name="arrow" size={16} />
          </a>
        </header>

        <div class="products__grid">
          {laptopItems.map((product) => <ProductCard lang={lang} product={product} />)}
        </div>
      </div>
    </section>
  )
}

{
  serverItems.length > 0 && (
    <section class="band products">
      <div class="wrap products__inner">
        <header class="products__head">
          <div class="products__titleWrap">
            <h2 class="h2">{t('server.title')}</h2>
            <p class="lead products__sub">{t('server.lead')}</p>
          </div>
          <a class="products__all" href={serversHref(lang)}>
            {t('server.all')}
            <Icon name="arrow" size={16} />
          </a>
        </header>

        <div class="products__grid">
          {serverItems.map((product) => <ProductCard lang={lang} product={product} />)}
        </div>
      </div>
    </section>
  )
}

{
  gpuItems.length > 0 && (
    <section class="band products">
      <div class="wrap products__inner">
        <header class="products__head">
          <div class="products__titleWrap">
            <h2 class="h2">{t('gpu.title')}</h2>
            <p class="lead products__sub">{t('gpu.lead')}</p>
          </div>
          <a class="products__all" href={href(lang, 'gpu')}>
            {t('gpu.all')}
            <Icon name="arrow" size={16} />
          </a>
        </header>

        <div class="products__grid">
          {gpuItems.map((product) => <ProductCard lang={lang} product={product} />)}
        </div>
      </div>
    </section>
  )
}

<OnSite lang={lang} />

<PaymentSteps lang={lang} />

<section class="band why">
  <div class="wrap why__grid">
    {
      why.map((item) => (
        <div class="why__item">
          <span class="why__icon"><Icon name={item.icon} size={24} /></span>
          <h3 class="h3">{item.title}</h3>
          <p class="why__body">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 80% 40%, #22433350, transparent 55%), #0d1210;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(#91caaa08 1px, transparent 1px), linear-gradient(90deg, #91caaa08 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, transparent, #000);
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    top: -400px;
    left: 36%;
    border-radius: 50%;
    background: #afffd533;
    filter: blur(100px);
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: center;
    padding-block: 88px 70px;
    min-height: 670px;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }

  .hero__text > .chip { background: transparent; border: 0; padding: 0; letter-spacing: .12em; font-size: 10px; }
  .hero__text > .chip .chip__dot { box-shadow: 0 0 12px #91e6b9; }

  .hero__title {
    max-width: 620px;
    font-size: clamp(46px, 5.4vw, 76px);
    letter-spacing: -.06em;
    line-height: 1.04;
  }

  .hero__title span { display: block; color: #a7e8c2; }

  .hero__sub { max-width: 480px; font-size: 16px; line-height: 1.8; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  .hero__trust {
    list-style: none;
    margin: 10px 0 0;
    padding: 16px 0 0;
    width: 100%;
    border-top: 1px solid var(--line-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  .hero__trustItem {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-2);
  }

  .hero__trustIcon {
    color: var(--accent);
    display: inline-flex;
  }

  .hero__figure {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .products__inner {
    padding-block: 76px 82px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 22px;
  }

  .products__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .products__titleWrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .products__sub {
    font-size: 15px;
    max-width: 640px;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }


  .why__grid {
    padding-block: 70px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .why__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .why__icon {
    color: var(--accent);
    display: inline-flex;
  }

  .why__body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding-block: 58px;
      min-height: auto;
    }
    .hero__figure {
      width: min(100%, 560px);
      margin-inline: auto;
    }
  }

  @media (max-width: 680px) {
    .products__head { flex-direction: column; align-items: flex-start; gap: 20px; }
    .products__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .why__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
