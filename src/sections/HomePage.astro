---
import ServiceHome, { type ServiceProduct } from '../islands/ServiceHome';
import OnSite from '../components/OnSite.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { configuredPriceCents, defaultChoice, miniPcHref, pick, products, serversHref } from '../data/catalogue';
import type { Lang } from '../i18n/ui';
import { serviceCopy } from '../i18n/service';
import { href } from '../i18n/utils';
import { isRentalProduct } from '../lib/rental';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = serviceCopy[lang];
const catalogue: ServiceProduct[] = products.map((product) => {
  const section = product.section ?? 'miniPc';
  const route = section === 'nas' ? 'nasProduct' : section === 'laptop' ? 'laptopProduct' : section === 'gpu' ? 'gpuProduct' : section === 'server' ? 'serverProduct' : 'product';
  return {
    slug: product.slug,
    name: product.name,
    section,
    summary: product.summary.map((row) => pick(row.value, lang)).join(' · '),
    image: product.images?.[0],
    url: href(lang, route, product.slug),
    valueCents: configuredPriceCents(product, defaultChoice(product)),
    rentalAvailable: isRentalProduct(product),
  };
});
---

<ServiceHome client:load lang={lang} products={catalogue} miniPcUrl={miniPcHref(lang)} serverUrl={serversHref(lang)} />
<OnSite lang={lang} />

<section class="service-contact" id="contatti">
  <div class="wrap service-contact__inner">
    <div><p class="service-overline">{c.contactEyebrow}</p><h2>{c.contactTitle}</h2><p class="service-contact__lead">{c.contactBody}</p></div>
    <div class="service-contact__actions"><ObfuscatedEmail lang={lang} label={c.contactCta} class="btn btn--primary" /><p>{c.contactNote}</p></div>
  </div>
</section>
