---
import Base from '../../../layouts/Base.astro';
import NasIndex from '../../../sections/NasIndex.astro';
import { nasProduct, pick } from '../../../data/catalogue';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  route="nasProduct"
  param={nasProduct?.slug}
  active="nas"
  title={`${nasProduct?.name ?? t('meta.nas.title')} — Compud`}
  description={nasProduct ? pick(nasProduct.tagline, lang) : t('meta.nas.description')}
>
  <NasIndex lang={lang} />
</Base>
